# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are inlined into the browser bundle — keep secrets out of them.

# Sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-12

# Sanity (server only) — write access for /admin mutations
SANITY_API_WRITE_TOKEN=

# Clerk (public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk (server only)
CLERK_SECRET_KEY=
